{
  "openapi": "3.0.0",
  "info": {
    "title": "libredesk API overlay",
    "description": "Hand-written operations for helpdesk routes that exist in Libredesk v2.9.2 but are absent from the published docs spec. Every shape is derived from the Go sources at tag v2.9.2 (see x-source on each operation and docs/SPEC_NOTES.md). Merged into src/openapi.json at load time.",
    "version": "v2.9.2"
  },
  "paths": {
    "/api/v1/conversations/sidebar-counts": {
      "get": {
        "tags": ["Conversations"],
        "summary": "Get Sidebar Counts",
        "operationId": "handleGetSidebarCounts",
        "description": "Open-conversation counts for the inbox sidebar badges of the caller: assigned, mentioned, unassigned and all, plus one count per view the caller can access (personal views and shared views of the caller's teams). Per-view counts are scan-capped at 100 in the code (the UI shows 99+). Requires the `conversations:read` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/conversation.go", "handler": "handleGetSidebarCounts" },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Counts retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SidebarCountsResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/drafts": {
      "get": {
        "tags": ["Conversations"],
        "summary": "Get All Drafts",
        "operationId": "handleGetAllDrafts",
        "description": "All unsent reply and private-note drafts saved by the caller, across conversations. Any authenticated agent.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/draft.go", "handler": "handleGetAllDrafts" },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Drafts retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationDraftListResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/conversations/{uuid}/draft": {
      "post": {
        "tags": ["Conversations"],
        "summary": "Save Conversation Draft",
        "operationId": "handleUpsertConversationDraft",
        "description": "Saves or updates the caller's draft for a conversation. `type` defaults to `reply`. The request is rejected with 400 when `content` is blank and `meta` is empty or `{}`, and when `meta` is larger than 32 KB. The caller must have access to the conversation.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/draft.go", "handler": "handleUpsertConversationDraft" },
        "parameters": [
          { "name": "uuid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Conversation UUID" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftRequest" } } }
        },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Draft saved",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationDraftResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Conversations"],
        "summary": "Delete Conversation Draft",
        "operationId": "handleDeleteConversationDraft",
        "description": "Deletes the caller's draft for a conversation. Without `type`, drafts of every type are deleted. The handler does not check conversation access: it only touches the caller's own drafts.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/draft.go", "handler": "handleDeleteConversationDraft" },
        "parameters": [
          { "name": "uuid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Conversation UUID" },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["reply", "private_note"] },
            "description": "Draft type to delete. Omit to delete all types."
          }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Draft deleted",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/conversations/{uuid}/macros/{id}/apply": {
      "post": {
        "tags": ["Conversations"],
        "summary": "Apply Macro To Conversation",
        "operationId": "handleApplyMacro",
        "description": "Applies a list of macro actions to a conversation and increments the macro's usage count. The body is a JSON array of actions (not an object), at most one action per type. Allowed action types: assign_team, assign_user, set_status, set_priority, add_tags, set_tags, remove_tags; send_reply and send_private_note are refused (403). The caller needs the permission matching each action type. Answers 200 when every action succeeded, 207 when only some did, and 500 when none did. The success body is `{\"message\": ...}`, not the usual status/data envelope.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/macro.go", "handler": "handleApplyMacro" },
        "parameters": [
          { "name": "uuid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Conversation UUID" },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Macro ID" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroApplyRequest" } } }
        },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "All actions applied",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroApplyResponse" } } }
          },
          "207": {
            "description": "Some actions applied",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroApplyResponse" } } }
          },
          "400": { "description": "Invalid request or duplicate action types", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden or action not allowed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Conversation or macro not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "No action could be applied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/macros": {
      "get": {
        "tags": ["Macros"],
        "summary": "Get Macros",
        "operationId": "handleGetMacros",
        "description": "Every macro with its message content and its actions (each action carries `display_value`, the name of the team, agent, status or priority it targets). Any authenticated agent. Use `search_macros` to list only the macros the caller may apply, or `get_macros_compact` for a list without the message content.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/macro.go", "handler": "handleGetMacros" },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Macros retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroListResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/macros/compact": {
      "get": {
        "tags": ["Macros"],
        "summary": "Get Macros Compact",
        "operationId": "handleGetMacrosCompact",
        "description": "Macros without their message content (`has_message_content` tells whether there is one), filtered by name, newest update first. Without `page_size` (or with 0) every match is returned. Requires the `macros:manage` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/macro.go", "handler": "handleGetMacrosCompact" },
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Case-insensitive substring of the macro name" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "Page number, used when page_size is set" },
          { "name": "page_size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 500 }, "description": "Items per page, at most 500. 0 or absent: return every match" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Macros retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroCompactListResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/macros/search": {
      "get": {
        "tags": ["Macros"],
        "summary": "Search Macros",
        "operationId": "handleSearchMacros",
        "description": "The 30 most used macros the caller may apply (visibility all, own, or one of the caller's teams), without their message content, optionally filtered by name and by where they are offered. Any authenticated agent.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/macro.go", "handler": "handleSearchMacros" },
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Case-insensitive substring of the macro name" },
          { "name": "view", "in": "query", "required": false, "schema": { "type": "string", "enum": ["replying", "starting_conversation", "adding_private_note"] }, "description": "Keep only the macros offered in this context. Any other value is a 400" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Macros retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroCompactListResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/macros/{id}": {
      "get": {
        "tags": ["Macros"],
        "summary": "Get Macro",
        "operationId": "handleGetMacro",
        "description": "A single macro with its message content and its actions. Any authenticated agent; the macro's visibility is not checked on this route.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/macro.go", "handler": "handleGetMacro" },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Macro ID" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Macro retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MacroResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/agents/compact": {
      "get": {
        "tags": ["Agents"],
        "summary": "Get Agents Compact",
        "operationId": "handleGetAgentsCompact",
        "description": "Agents and AI assistants in a short form (ID, name, email, enabled, availability), the list the web UI offers when assigning a conversation. Any authenticated agent, unlike `get_agents` which needs `users:manage`. Use the returned `id` as `assignee_id` of `update_user_assignee`.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/users.go", "handler": "handleGetAgentsCompact" },
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Case-insensitive substring of the name (agents: also matched on the email)" },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["agent", "ai_assistant"] }, "description": "Keep only this kind of user. Any other value is a 400" },
          { "name": "enabled", "in": "query", "required": false, "schema": { "type": "string", "enum": ["true"] }, "description": "Only the exact value `true` keeps the enabled users; anything else returns enabled and disabled ones" },
          { "name": "ids", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated IDs (at most 200, non-numeric or non-positive entries are ignored). When given, only these are returned and every other filter and the pagination are ignored" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "Page number, used when page_size is set" },
          { "name": "page_size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 500 }, "description": "Items per page, at most 500. 0 or absent: return every match" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentCompactListResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/teams/compact": {
      "get": {
        "tags": ["Teams"],
        "summary": "Get Teams Compact",
        "operationId": "handleGetTeamsCompact",
        "description": "Teams in a short form (ID, name, emoji), the list the web UI offers when assigning a conversation. Any authenticated agent, unlike `get_teams` which needs `teams:manage`. Use the returned `id` as `assignee_id` of `update_team_assignee`.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/teams.go", "handler": "handleGetTeamsCompact" },
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Case-insensitive substring of the name (agents: also matched on the email)" },
          { "name": "ids", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated IDs (at most 200, non-numeric or non-positive entries are ignored). When given, only these are returned and every other filter and the pagination are ignored" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "Page number, used when page_size is set" },
          { "name": "page_size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 500 }, "description": "Items per page, at most 500. 0 or absent: return every match" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamCompactListResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/automations/rules": {
      "get": {
        "tags": ["Automations"],
        "summary": "Get Automation Rules",
        "operationId": "handleGetAutomationRules",
        "description": "Automation rules of one type, ordered by weight. Requires the `automations:manage` permission. Pass `type`: a rule list is always read per type (an empty or unknown type returns an empty list, not every rule).",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/automation.go", "handler": "handleGetAutomationRules" },
        "parameters": [
          { "name": "type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["new_conversation", "conversation_update", "time_trigger"] }, "description": "Rule type to list" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Rules retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutomationRuleListResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `automations:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "tags": ["Automations"],
        "summary": "Create Automation Rule",
        "operationId": "handleCreateAutomationRule",
        "description": "Creates an automation rule. Requires the `automations:manage` permission. The rule is ENABLED as soon as it is created (the table default) and starts applying to the next matching conversation; use `toggle_automation_rule` to disable it. The server does not validate the content of `rules`: a malformed rule is stored and then silently never matches, so read it back with `get_automation_rule`. Example, assign every new conversation whose subject contains a text to agent 5: type `new_conversation`, events `[]`, rules `[{\"group_operator\":\"AND\",\"groups\":[{\"logical_op\":\"AND\",\"rules\":[{\"field\":\"subject\",\"field_type\":\"conversation\",\"operator\":\"contains\",\"value\":\"Company switched from\",\"case_sensitive_match\":false}]}],\"actions\":[{\"type\":\"assign_user\",\"value\":[\"5\"]}]}]`.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/automation.go", "handler": "handleCreateAutomationRule" },
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutomationRuleRequest" } } }
        },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Rule created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutomationRuleResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `automations:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/automations/rules/{id}": {
      "get": {
        "tags": ["Automations"],
        "summary": "Get Automation Rule",
        "operationId": "handleGetAutomationRule",
        "description": "A single automation rule with its conditions and actions, and whether it is enabled. Requires the `automations:manage` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/automation.go", "handler": "handleGetAutomationRule" },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Automation rule ID" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Rule retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutomationRuleResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `automations:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/automations/rules/{id}/toggle": {
      "put": {
        "tags": ["Automations"],
        "summary": "Toggle Automation Rule",
        "operationId": "handleToggleAutomationRule",
        "description": "Flips the `enabled` flag of a rule (enabled becomes disabled and the reverse) and returns the updated rule. There is no body and no way to set the state explicitly, so read the rule first if the current state matters. Requires the `automations:manage` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/automation.go", "handler": "handleToggleAutomationRule" },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Automation rule ID" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Rule toggled",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutomationRuleResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `automations:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/shared-views": {
      "get": {
        "tags": ["Views"],
        "summary": "Get Shared Views",
        "operationId": "handleGetAllSharedViews",
        "description": "Every shared view (visible to all agents or to one team), most recently updated first. Personal views are not listed. Requires the `shared_views:manage` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/views.go", "handler": "handleGetAllSharedViews" },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Shared views retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SharedViewListResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `shared_views:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "tags": ["Views"],
        "summary": "Create Shared View",
        "operationId": "handleCreateSharedView",
        "description": "Creates a shared view: a saved filter on the conversation list that appears in the sidebar of every agent (`visibility` all) or of the members of one team (`visibility` team with `team_id`). Requires the `shared_views:manage` permission. The filters are validated: an unknown field is refused. Editing and deleting a view stay in the web UI. Example, the open conversations carrying tag 3: `{\"name\":\"Compromise alerts\",\"visibility\":\"all\",\"filters\":{\"logic\":\"AND\",\"rules\":[{\"model\":\"conversations\",\"field\":\"tags\",\"operator\":\"contains\",\"value\":\"[3]\"},{\"model\":\"conversations\",\"field\":\"status_id\",\"operator\":\"not equals\",\"value\":\"4\"}]}}`.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/views.go", "handler": "handleCreateSharedView" },
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SharedViewRequest" } } }
        },
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Shared view created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SharedViewResponse" } } }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `shared_views:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/shared-views/{id}": {
      "get": {
        "tags": ["Views"],
        "summary": "Get Shared View",
        "operationId": "handleGetSharedView",
        "description": "A single shared view with its filters. A personal view answers 404. Requires the `shared_views:manage` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/views.go", "handler": "handleGetSharedView" },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "View ID" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Shared view retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SharedViewResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: requires the `shared_views:manage` permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/inboxes/{id}": {
      "get": {
        "tags": ["Inboxes"],
        "summary": "Get Inbox",
        "operationId": "handleGetInbox",
        "description": "A single inbox by ID. Passwords, OAuth tokens and client secrets in `config` are masked. Unlike the inbox list, this route requires the `inboxes:manage` permission.",
        "x-source": { "repo": "abhinavxd/libredesk", "tag": "v2.9.2", "file": "cmd/inboxes.go", "handler": "handleGetInbox" },
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Inbox ID" }
        ],
        "security": [{ "basicAuth": [] }, { "tokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Inbox retrieved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InboxDetailResponse" } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SidebarCounts": {
        "type": "object",
        "properties": {
          "assigned": { "type": "integer" },
          "mentioned": { "type": "integer" },
          "unassigned": { "type": "integer" },
          "all": { "type": "integer" },
          "views": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "description": "Count per accessible view, keyed by view ID."
          }
        }
      },
      "SidebarCountsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/SidebarCounts" }
        }
      },
      "DraftRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["reply", "private_note"],
            "default": "reply",
            "description": "Draft type. Defaults to `reply` when omitted or empty."
          },
          "content": { "type": "string", "description": "Draft content (HTML). Inline images are rewritten to cid: references on save." },
          "meta": { "description": "Free-form JSON stored with the draft, at most 32 KB. The code does not constrain its shape." }
        }
      },
      "ConversationDraft": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "conversation_id": { "type": "integer", "format": "int64" },
          "conversation_uuid": { "type": "string" },
          "user_id": { "type": "integer", "format": "int64" },
          "type": { "type": "string", "enum": ["reply", "private_note"] },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "meta": { "description": "Free-form JSON saved with the draft." }
        }
      },
      "ConversationDraftResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/ConversationDraft" }
        }
      },
      "ConversationDraftListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ConversationDraft" } }
        }
      },
      "MacroAction": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["assign_team", "assign_user", "set_status", "set_priority", "add_tags", "set_tags", "remove_tags"],
            "description": "Action type. At most one action per type in a request."
          },
          "value": {
            "type": "array",
            "items": { "type": "string" },
            "description": "assign_team, assign_user, set_status and set_priority read the first element as a numeric ID (team, agent, status, priority) sent as a string. The three tag actions take the list of tag names."
          }
        }
      },
      "MacroApplyRequest": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MacroAction" },
        "description": "Actions to apply, as a JSON array."
      },
      "AgentCompactListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/AgentCompact" } }
        }
      },
      "TeamCompactListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/TeamCompact" } }
        }
      },
      "AutomationRuleCondition": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "description": "For field_type conversation: subject, content (last message), status, priority, assigned_user, assigned_team, inbox, to, contact_email, hours_since_created, hours_since_first_reply, hours_since_last_reply, hours_since_resolved, hours_since_last_resolved, previous_status, previous_priority, previous_assigned_user, previous_assigned_team. For field_type contact_custom_attribute: the attribute key" },
          "field_type": { "type": "string", "enum": ["conversation", "contact_custom_attribute"] },
          "operator": { "type": "string", "enum": ["contains", "not contains", "equals", "not equals", "set", "not set", "greater than", "less than", "starts with"] },
          "value": { "type": "string", "description": "Text to compare with. IDs (status, priority, agent, team, inbox) are sent as strings" },
          "case_sensitive_match": { "type": "boolean" }
        }
      },
      "AutomationRuleGroup": {
        "type": "object",
        "properties": {
          "logical_op": { "type": "string", "enum": ["AND", "OR"], "description": "How the conditions of this group combine" },
          "rules": { "type": "array", "items": { "$ref": "#/components/schemas/AutomationRuleCondition" } }
        }
      },
      "AutomationRuleAction": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["assign_team", "assign_user", "set_status", "set_priority", "send_private_note", "send_reply", "set_sla", "add_tags", "set_tags", "remove_tags", "send_csat", "notify", "snooze", "trigger_webhook"], "description": "send_reply emails the customer and trigger_webhook calls an external URL: neither should be used without the user asking for it" },
          "value": { "type": "array", "items": { "type": "string" }, "description": "assign_team, assign_user, set_status, set_priority and set_sla read the first element as a numeric ID sent as a string; the tag actions take tag names; send_private_note and send_reply take the text" },
          "subject": { "type": "string", "description": "Only for the notify action" },
          "message": { "type": "string", "description": "Only for the notify action" },
          "recipients": { "type": "array", "items": { "type": "string" }, "description": "Only for the notify action: assignee, assigned_team, team:<id> or user:<id>" }
        }
      },
      "AutomationRuleBody": {
        "type": "object",
        "description": "One rule block. The record's type, events and execution mode are taken from the record, not from here",
        "properties": {
          "group_operator": { "type": "string", "enum": ["AND", "OR"], "description": "How the groups combine" },
          "groups": { "type": "array", "items": { "$ref": "#/components/schemas/AutomationRuleGroup" } },
          "actions": { "type": "array", "items": { "$ref": "#/components/schemas/AutomationRuleAction" } }
        }
      },
      "AutomationRuleRequest": {
        "type": "object",
        "required": ["name", "type", "rules"],
        "properties": {
          "name": { "type": "string", "maxLength": 140 },
          "description": { "type": "string", "maxLength": 300 },
          "type": { "type": "string", "enum": ["new_conversation", "conversation_update", "time_trigger"], "description": "new_conversation: on every new conversation. conversation_update: on the listed events. time_trigger: periodic, on the hours_since_* conditions" },
          "events": { "type": "array", "items": { "type": "string", "enum": ["conversation.user.assigned", "conversation.team.assigned", "conversation.status.change", "conversation.priority.change", "conversation.message.outgoing", "conversation.message.incoming"] }, "description": "Only for conversation_update; leave empty for the other types" },
          "rules": { "type": "array", "items": { "$ref": "#/components/schemas/AutomationRuleBody" }, "description": "A JSON array of rule blocks, not a string" }
        }
      },
      "AutomationRule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "type": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" },
          "weight": { "type": "integer", "description": "Order of evaluation, lowest first" },
          "execution_mode": { "type": "string", "enum": ["all", "first_match"], "description": "For new_conversation rules: apply every matching rule, or only the first" },
          "rules": { "type": "array", "items": { "$ref": "#/components/schemas/AutomationRuleBody" } }
        }
      },
      "AutomationRuleResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/AutomationRule" }
        }
      },
      "AutomationRuleListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/AutomationRule" } }
        }
      },
      "SharedViewFilterNode": {
        "type": "object",
        "description": "Either a group (logic + rules, nested one level at most) or a condition (model, field, operator, value). Allowed model.field pairs: conversations.status_id, priority_id, assigned_team_id, assigned_user_id, inbox_id, last_message_at, last_interaction_at, last_interaction_sender, created_at, waiting_since, next_sla_deadline_at, snoozed_until, sla_policy_id, tags; conversation_statuses.id, name; users.email, external_user_id; inboxes.channel. There is no subject or content field: a view cannot filter on text",
        "properties": {
          "logic": { "type": "string", "enum": ["AND", "OR"] },
          "rules": { "type": "array", "items": { "type": "object" } },
          "model": { "type": "string", "enum": ["conversations", "conversation_statuses", "users", "inboxes"] },
          "field": { "type": "string" },
          "operator": { "type": "string", "description": "equals, not equals, greater than, less than, in, between, contains, not contains, ilike, set, not set. For tags: contains, not contains (value is a JSON array of tag IDs as text, for example [3]), set, not set" },
          "value": { "type": "string", "description": "IDs are sent as text" }
        }
      },
      "SharedViewRequest": {
        "type": "object",
        "required": ["name", "visibility", "filters"],
        "properties": {
          "name": { "type": "string" },
          "visibility": { "type": "string", "enum": ["all", "team"], "description": "all: every agent. team: the members of team_id" },
          "team_id": { "type": "integer", "description": "Required when visibility is team" },
          "filters": { "$ref": "#/components/schemas/SharedViewFilterNode" }
        }
      },
      "SharedView": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "visibility": { "type": "string", "enum": ["all", "team", "user"] },
          "team_id": { "type": "integer" },
          "filters": { "$ref": "#/components/schemas/SharedViewFilterNode" }
        }
      },
      "SharedViewResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/SharedView" }
        }
      },
      "SharedViewListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/SharedView" } }
        }
      },
      "MacroActionResponse": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "Action type, e.g. assign_team, assign_user, set_status, set_priority, add_tags, set_tags, remove_tags" },
          "value": { "type": "array", "items": { "type": "string" }, "description": "IDs (sent as strings) or tag names, as stored" },
          "display_value": { "type": "array", "items": { "type": "string" }, "nullable": true, "description": "Names matching value (team, agent, status or priority); null when it cannot be resolved" },
          "subject": { "type": "string", "description": "Only for the notify action" },
          "message": { "type": "string", "description": "Only for the notify action" },
          "recipients": { "type": "array", "items": { "type": "string" }, "description": "Only for the notify action" }
        }
      },
      "Macro": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "actions": { "type": "array", "items": { "$ref": "#/components/schemas/MacroActionResponse" } },
          "visibility": { "type": "string", "enum": ["all", "team", "user"], "description": "Who may apply the macro: everyone, the members of team_id, or the agent user_id" },
          "visible_when": { "type": "array", "items": { "type": "string", "enum": ["replying", "starting_conversation", "adding_private_note"] } },
          "message_content": { "type": "string", "description": "Reply text the macro inserts" },
          "user_id": { "type": "string", "nullable": true, "description": "Owner agent ID as a string, null when not set" },
          "team_id": { "type": "string", "nullable": true, "description": "Team ID as a string, null when not set" },
          "usage_count": { "type": "integer" }
        }
      },
      "MacroCompact": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "actions": { "type": "array", "items": { "$ref": "#/components/schemas/MacroActionResponse" } },
          "visibility": { "type": "string", "enum": ["all", "team", "user"], "description": "Who may apply the macro: everyone, the members of team_id, or the agent user_id" },
          "visible_when": { "type": "array", "items": { "type": "string", "enum": ["replying", "starting_conversation", "adding_private_note"] } },
          "has_message_content": { "type": "boolean", "description": "Whether the macro inserts a reply text (the text itself is omitted from this shape)" },
          "user_id": { "type": "string", "nullable": true, "description": "Owner agent ID as a string, null when not set" },
          "team_id": { "type": "string", "nullable": true, "description": "Team ID as a string, null when not set" },
          "usage_count": { "type": "integer" }
        }
      },
      "MacroResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/Macro" }
        }
      },
      "MacroListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Macro" } }
        }
      },
      "MacroCompactListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/MacroCompact" } }
        }
      },
      "MacroApplyResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "description": "Localised confirmation, or the partial-application notice on 207." }
        }
      },
      "InboxDetailAlias": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "verification_status": { "type": "string" },
          "verified_at": { "type": "string", "format": "date-time", "description": "Present once verified." }
        }
      },
      "InboxDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "uuid": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "channel": { "type": "string", "description": "Channel identifier, e.g. email or livechat. The docs spec lists only those two; the code also runs a WhatsApp channel." },
          "enabled": { "type": "boolean" },
          "csat_enabled": { "type": "boolean" },
          "prompt_tags_on_reply": { "type": "boolean" },
