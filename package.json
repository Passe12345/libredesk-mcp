{
  "name": "libredesk-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Libredesk - the open-source customer support desk.",
  "type": "module",
  "bin": {
    "libredesk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js && cp src/openapi.json src/openapi.overlay.json dist/",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-spec": "node scripts/fetch-spec.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "libredesk",
    "helpdesk",
    "customer-support"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
